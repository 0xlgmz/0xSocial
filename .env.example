POSTGRES_DB=db-name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password

# Resend. Leave all fields empty to log emails locally instead of sending them.
RESEND_API_KEY=
# Example: 0xSocial <noreply@example.com>
RESEND_FROM=
# Public frontend origin used in verification and password reset links.
# Example: https://example.com
APP_PUBLIC_URL=

# Cloudflare R2. Leave all fields empty to disable image uploads locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Example: https://media.example.com
# Optional override for S3-compatible local testing.
R2_ENDPOINT=

# Advertising is fail-closed. Keep both switches false in local development
# and automated tests. Populate the AdSense values only after site approval.
MONETIZATION_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_FEED_ENABLED=false
ADSENSE_FEED_SLOT_ID=
ADSENSE_FEED_FORMAT=fluid
ADSENSE_FEED_LAYOUT_KEY=
ADSENSE_FEED_FIRST_AFTER_POSTS=5
ADSENSE_FEED_REPEAT_EVERY_POSTS=8
ADSENSE_FEED_MAXIMUM_ADS=3
